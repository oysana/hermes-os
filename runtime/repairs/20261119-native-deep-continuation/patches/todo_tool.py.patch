@@ -200,0 +207,17 @@
+def _apply_session_goal(goal: Any, session_id: str, platform: str) -> dict[str, Any]:
+    """Validate the ``goal`` argument at the tool boundary, then register it."""
+    if platform != "telegram":
+        return {"ok": False, "error": "goal registration through todo_list is enabled only for Telegram"}
+    if not isinstance(goal, dict):
+        return {"ok": False, "error": f"goal must be an object, got {type(goal).__name__}"}
+    if set(goal) - {"objective", "contract"}:
+        return {"ok": False, "error": "unknown goal field"}
+    try:
+        from hermes_cli.goals import register_session_goal
+    except ImportError as exc:
+        return {"ok": False, "error": f"goal registration unavailable: {exc}"}
+    return register_session_goal(
+        session_id, goal.get("objective"),
+        contract=goal.get("contract"))
+
+
