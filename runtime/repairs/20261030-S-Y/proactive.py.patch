 def content_digest(content):
     # The cron script boundary strips surrounding whitespace before delivery.
     return hashlib.sha256(content.strip().encode()).hexdigest()
+
+
+def memory_proposal_snapshot(directory):
+    """Fingerprint distinct proposal contents without interpreting their contents."""
+    proposals = sorted(directory.glob('*.md'), key=lambda path: path.name)
+    if not proposals:
+        return proposals, None
+    content_fingerprints = set()
+    for proposal in proposals:
+        try:
+            content = proposal.read_bytes()
+        except OSError:
+            return [], None
+        content_fingerprints.add(hashlib.sha256(content).hexdigest())
+    digest = hashlib.sha256()
+    for fingerprint in sorted(content_fingerprints):
+        digest.update(fingerprint.encode('ascii'))
+        digest.update(b'\n')
+    return proposals, digest.hexdigest()
 
 
