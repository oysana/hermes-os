+async def topic_read_metadata(client, entity):
+    """Read counters for the owner's S bot only; never inspect message bodies or mark read."""
+    from telethon.tl.functions.messages import GetPeerDialogsRequest, GetForumTopicsRequest
+    dialog_result = await client(GetPeerDialogsRequest([types.InputDialogPeer(entity)]))
+    topic_result = await client(GetForumTopicsRequest(
+        peer=entity, offset_date=None, offset_id=0, offset_topic=0, limit=100))
+    dialogs = [{key: getattr(item, key, None) for key in
+                ['top_message', 'read_inbox_max_id', 'read_outbox_max_id', 'unread_count',
+                 'unread_mentions_count', 'unread_reactions_count', 'unread_mark']}
+               for item in dialog_result.dialogs]
+    topics = [{key: getattr(item, key, None) for key in
+               ['id', 'top_message', 'read_inbox_max_id', 'read_outbox_max_id', 'unread_count',
+                'unread_mentions_count', 'unread_reactions_count']}
+              for item in topic_result.topics]
+    return {'scope': 'owner S bot; server read-state metadata only', 'changes': False,
+            'dialogs': dialogs, 'topics': topics, 'total_topics': topic_result.count,
+            'complete': topic_result.count <= len(topics)}
+
+
+async def enable_s_topic_read_sync(client):
+    """Attach to the existing reader; no new timer, daemon, or contact-message operation."""
+    from topic_read_sync import reconcile
+    try:
+        bot = await client.get_entity("@sqecea_bot")
+        if getattr(bot, 'bot', None) is not True:
+            return
+        peer = await client.get_input_entity(bot)
+    except Exception as error:
+        logging.getLogger(__name__).debug("S read sync unavailable: %s", type(error).__name__)
+        return
+    lock = asyncio.Lock()
+
+    async def sync():
+        async with lock:
+            try:
+                return await asyncio.wait_for(reconcile(client, peer, apply=True), timeout=8)
+            except Exception as error:
+                logging.getLogger(__name__).debug("S read sync unavailable: %s", type(error).__name__)
+
+    @client.on(events.Raw(types.UpdateReadHistoryInbox))
+    async def topic_was_read(update):
+        if (getattr(getattr(update, 'peer', None), 'user_id', None) == bot.id
+                and getattr(update, 'top_msg_id', None)):
+            await sync()
+
+    await sync()
