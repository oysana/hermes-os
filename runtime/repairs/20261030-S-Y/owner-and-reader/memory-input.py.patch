+def telegram_owner_id():
+    """Reuse the native account principal, never infer identity from a message's role."""
+    try:
+        child = subprocess.run(
+            [str(p.ROOT / 'profiles/yqecea/tools/tguser-env/bin/python'), '-B',
+             str(p.ROOT / 'shared/communications/tg-personal.py'), 'status'],
+            capture_output=True, text=True, timeout=3)
+        if child.returncode != 0:
+            return None
+        data = json.loads(child.stdout)
+        if not isinstance(data, dict):
+            return None
+        principal = data.get('principal')
+        if (data.get('authorized') is not True or data.get('personal_account') is not True
+                or not isinstance(principal, dict) or principal.get('platform') != 'telegram'):
+            return None
+        sender = principal.get('sender_id')
+        return sender if isinstance(sender, str) and sender.isascii() and sender.isdecimal() and int(sender) > 0 else None
+    except (OSError, subprocess.TimeoutExpired, ValueError):
+        return None
